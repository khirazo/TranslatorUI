# Copy to translator-ui.toml and select it with TRANSLATOR_UI_CONFIG=translator-ui.toml.
# Keep API keys in .env and reference only their variable names here.

[app]
default_provider = "plamo-local"
save_translations = false

[[providers]]
id = "plamo-local"
name = "LM Studio / PLaMo 3"
kind = "openai_compatible"
enabled = true
base_url = "http://localhost:1234"
max_tokens = 512
default_translation_profile = "generic"

# Model metadata is separate from the live availability check.  The UI will only offer an id
# returned by the provider catalog, while these entries choose labels and safe prompt profiles.
[[providers.model_overrides]]
id = "plamo-3-translate-0.8b"
name = "PLaMo 3 Translate"
translation_profile = "plamo3"

[[providers.model_overrides]]
id = "microsoft/phi-4-mini-instruct"
name = "Phi-4 mini"

[[providers.model_overrides]]
id = "qwen/qwen3-coder-next"
name = "Qwen3 Coder Next"

# Exact overrides take precedence.  Rules are useful for future PLaMo model ids.
[[providers.model_rules]]
pattern = "^plamo-"
translation_profile = "plamo3"

# A generic OpenAI-compatible service does not receive PLaMo-specific prompt fields.
[[providers]]
id = "openai-compatible"
name = "OpenAI-compatible service"
kind = "openai_compatible"
enabled = false
base_url = "https://api.example.com"
api_key_env = "OPENAI_COMPAT_API_KEY"
translation_profile = "generic"

[[providers.model_overrides]]
id = "your-model-id"
name = "Standard"

[[providers.model_overrides]]
id = "reasoning-model-id"
name = "Reasoning"
efforts = ["low", "medium", "high"]
default_effort = "medium"
effort_request_field = "reasoning_effort"

# ACP entries are retained as configuration only until the ACP adapter is implemented.
[[providers]]
id = "codex-acp"
name = "Codex ACP"
kind = "acp"
enabled = false
command = ["codex", "acp"]
timeout_seconds = 180
mode = "ask"
