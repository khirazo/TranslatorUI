# Provider registry. Copy translator-ui.toml.example to translator-ui.toml for multiple providers.
# The path is relative to the process working directory, or may be absolute.
TRANSLATOR_UI_CONFIG=

# Legacy single-provider fallback. Use only when TRANSLATOR_UI_CONFIG is empty.
# Docker Compose uses host.docker.internal; direct host execution replaces it with localhost.
LLM_ENDPOINT=http://host.docker.internal:1234
LLM_MODEL_ENDPOINT=/v1/models
LLM_CHAT_ENDPOINT=/v1/chat/completions
LLM_MODEL=plamo-3-translate-0.8b
LLM_API_KEY=
LLM_MAX_TOKENS=512
SAVE_TRANSLATIONS=false
OPENAI_COMPAT_API_KEY=
