# Docker Compose 内の TranslatorUI から LM Studio を呼ぶ既定値。
# ホスト上で直接 Uvicorn を起動する場合は http://localhost:1234 に上書きする。
LLM_ENDPOINT=http://host.docker.internal:1234
LLM_MODEL_ENDPOINT=/v1/models
LLM_CHAT_ENDPOINT=/v1/chat/completions
LLM_MODEL=plamo-3-translate-0.8b
LLM_API_KEY=
LLM_MAX_TOKENS=512
SAVE_TRANSLATIONS=false