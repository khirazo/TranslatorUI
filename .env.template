# Provider registry. Copy translator-ui.toml.example to translator-ui.toml for multiple providers.
# The path is relative to the process working directory, or may be absolute.
TRANSLATOR_UI_CONFIG=

# Legacy single-provider fallback. Use only when TRANSLATOR_UI_CONFIG is empty.
LLM_ENDPOINT=http://localhost:1234
LLM_MODEL_ENDPOINT=/v1/models
LLM_CHAT_ENDPOINT=/v1/chat/completions
LLM_MODEL=plamo-3-translate-0.8b
LLM_API_KEY=
LLM_MAX_TOKENS=512
SAVE_TRANSLATIONS=false
OPENAI_COMPAT_API_KEY=

# Optional: standard HTTPX proxy settings for requests to OpenAI-compatible LLM endpoints.
# For an HTTP forward proxy, use an http:// URL even for HTTPS upstream endpoints.
# HTTP_PROXY=http://proxy.example.invalid:8080
# HTTPS_PROXY=http://proxy.example.invalid:8080
# ALL_PROXY=http://proxy.example.invalid:8080
# Keep local LM Studio and other direct hosts out of the proxy. Add hosts as needed.
# NO_PROXY=localhost,127.0.0.1,::1
